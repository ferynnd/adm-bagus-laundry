<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">


        <androidx.cardview.widget.CardView
            android:id="@+id/btnRoutesBase"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="5dp"
            app:cardBackgroundColor="@color/background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/inputName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATA AKTIF"
            android:layout_marginStart="20dp"
            android:textColor="@color/blue900"
            android:fontFamily="@font/inter_semibold"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@id/btnRoutesBase"
            app:layout_constraintTop_toTopOf="@id/btnRoutesBase"
            app:layout_constraintBottom_toBottomOf="@id/btnRoutesBase"
            />

        <ImageView
            android:id="@+id/nextBase"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/next"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="@id/btnRoutesBase"
            app:layout_constraintTop_toTopOf="@id/inputName"
            app:layout_constraintBottom_toBottomOf="@id/inputName"
            app:tint="@color/blue900" />

</androidx.constraintlayout.widget.ConstraintLayout>