<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardReportLaundry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp">

    <androidx.constraintlayout.widget.Guideline
    android:id="@+id/guidelineHeaderBottom"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:layout_constraintGuide_begin="55dp" />

    <!-- BACKGROUND ORANGE -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/orage"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="55dp">

            <!-- WHITE CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardForeground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- TABLE -->
                    <TableLayout
                        android:id="@+id/tableLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <!-- PELANGGAN -->
                        <TableRow>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/inter"
                                android:padding="10dp"
                                android:text="PELANGGAN"
                                android:textAlignment="textStart"
                                android:textColor="@color/blue900"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/inputCustommer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:fontFamily="@font/inter_semibold"
                                android:padding="10dp"
                                android:textAlignment="textEnd"
                                android:textColor="@color/blue900"
                                android:textSize="14sp"
                                tools:text="NamaKu" />

                        </TableRow>

                        <!-- KARYAWAN -->
                        <TableRow>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/inter"
                                android:padding="10dp"
                                android:text="KARYAWAN"
                                android:textAlignment="textStart"
                                android:textColor="@color/blue900"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/inputEmployment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:fontFamily="@font/inter_semibold"
                                android:padding="10dp"
                                android:textAlignment="textEnd"
                                android:textColor="@color/blue900"
                                android:textSize="14sp"
                                tools:text="Karyawan" />

                        </TableRow>

                        <!-- CABANG -->
                        <TableRow>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/inter"
                                android:padding="10dp"
                                android:text="CABANG"
                                android:textAlignment="textStart"
                                android:textColor="@color/blue900"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/inputBranch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:fontFamily="@font/inter_semibold"
                                android:padding="10dp"
                                android:textAlignment="textEnd"
                                android:textColor="@color/blue900"
                                android:textSize="14sp"
                                tools:text="CABANG" />

                        </TableRow>

                        <!-- STATUS -->
                        <TableRow>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/inter"
                                android:padding="10dp"
                                android:text="STATUS"
                                android:textAlignment="textStart"
                                android:textColor="@color/blue900"
                                android:textSize="12sp" />

                            <androidx.cardview.widget.CardView
                                android:id="@+id/layoutStatus"
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="5dp"
                                android:layout_marginEnd="10dp"
                                app:cardBackgroundColor="@color/baseActive"
                                app:cardCornerRadius="5dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/inputStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:gravity="center"
                                    android:paddingVertical="10dp"
                                    android:textAllCaps="true"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    tools:text="DALAM PROSES" />

                            </androidx.cardview.widget.CardView>

                        </TableRow>

                        <!-- JUMLAH ITEM -->
                        <TableRow>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:fontFamily="@font/inter"
                                    android:padding="10dp"
                                    android:text="JUMLAH ITEM"
                                    android:textColor="@color/blue900"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter"
                                    android:padding="10dp"
                                    android:text="@string/pcs"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/inputCountItem"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:fontFamily="@font/inter_semibold"
                                android:padding="10dp"
                                android:textAlignment="textEnd"
                                android:textColor="@color/blue900"
                                android:textSize="14sp"
                                tools:text="10" />

                        </TableRow>

                        <!-- BERAT -->
                        <TableRow>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:fontFamily="@font/inter"
                                    android:padding="10dp"
                                    android:text="BERAT"
                                    android:textColor="@color/blue900"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter"
                                    android:padding="10dp"
                                    android:text="@string/berat"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/inputWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:fontFamily="@font/inter_semibold"
                                android:padding="10dp"
                                android:textAlignment="textEnd"
                                android:textColor="@color/blue900"
                                android:textSize="14sp"
                                tools:text="10 Kg" />

                        </TableRow>

                        <!-- TOTAL -->
                        <TableRow>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:fontFamily="@font/inter"
                                    android:padding="10dp"
                                    android:text="TOTAL HARGA"
                                    android:textColor="@color/blue900"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter"
                                    android:padding="10dp"
                                    android:text="@string/rupiah"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/inputTotalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:fontFamily="@font/inter_semibold"
                                android:padding="10dp"
                                android:textAlignment="textEnd"
                                android:textColor="@color/blue900"
                                android:textSize="14sp"
                                tools:text="Rp 100.000" />

                        </TableRow>

                    </TableLayout>

                    <!-- CATATAN -->
                    <TextView
                        android:id="@+id/titleNotes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter"
                        android:padding="10dp"
                        android:text="CATATAN"
                        android:textColor="@color/blue900"
                        android:textSize="12sp" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="15dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="@color/blueBase"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/inputNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:padding="10dp"
                            android:textColor="@color/gray900"
                            android:textSize="12sp"
                            tools:text="Ini catatan Ku" />

                    </androidx.cardview.widget.CardView>

                    <!-- LAYANAN -->
                    <TextView
                        android:id="@+id/titleLayanan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:fontFamily="@font/inter"
                        android:padding="10dp"
                        android:text="LAYANAN"
                        android:textColor="@color/blue900"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/layoutItemsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="15dp"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- TOP TITLE -->
    <TextView
        android:id="@+id/idTransactionLaundry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/gray900"
        android:textSize="18sp"
        android:translationZ="2dp"
        tools:text="CAB001234"
        app:layout_constraintBottom_toTopOf="@id/guidelineHeaderBottom"
        app:layout_constraintTop_toTopOf="@id/cardBackground"
        app:layout_constraintStart_toStartOf="@id/cardBackground" />

    <ImageView
        android:id="@+id/buttonDetail"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/detail"
        android:translationZ="2dp"
        app:layout_constraintTop_toTopOf="@id/cardBackground"
        app:layout_constraintBottom_toTopOf="@id/guidelineHeaderBottom"
        app:layout_constraintEnd_toEndOf="@id/cardBackground" />

    <ImageView
        android:id="@+id/buttonPrint"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_print"
        android:layout_marginEnd="20dp"
        android:translationZ="2dp"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="@id/cardBackground"
        app:layout_constraintBottom_toTopOf="@id/guidelineHeaderBottom"
        app:layout_constraintEnd_toStartOf="@id/buttonDetail"
        android:contentDescription="Print" />

</androidx.constraintlayout.widget.ConstraintLayout>