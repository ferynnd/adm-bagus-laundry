<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBackground"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        app:cardBackgroundColor="@color/greenBase"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardForeground"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="@id/cardBackground"
        app:layout_constraintEnd_toEndOf="@id/cardBackground"
        app:layout_constraintBottom_toBottomOf="@id/cardBackground"
        />

    <TextView
        android:id="@+id/inputTextUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NAMA"
        android:fontFamily="@font/inter_medium"
        android:textSize="18sp"
        android:textColor="@color/gray900"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toTopOf="@id/cardForeground"
        app:layout_constraintStart_toStartOf="@id/cardBackground"
        app:layout_constraintTop_toTopOf="@id/cardBackground"
        android:translationZ="2dp"
        />

    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/cardForeground"
        app:layout_constraintEnd_toEndOf="@id/cardForeground"
        app:layout_constraintTop_toTopOf="@id/cardForeground"
        app:layout_constraintBottom_toBottomOf="@id/cardForeground"
        >

        <TableRow>

            <TextView
                android:text="NAMA PANJANG"
                android:padding="10dp"
                android:textSize="12sp"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/blue900"
                android:textAlignment="textStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                /> <!-- kasih lebar minimum -->

             <TextView
                 android:id="@+id/inputFullname"
                android:text="Ferry Fernandp"
                android:padding="10dp"
                 android:textSize="14sp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/blue900"
                 android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
        </TableRow>

        <TableRow>
            <TextView
                android:text="ROLE"
                android:padding="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginStart="10dp"
                android:textColor="@color/blue900"
                android:textAlignment="textStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                /> <!-- kasih lebar minimum -->

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutRole"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/blueBase"
                android:layout_marginVertical="5dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                android:padding="10dp">

                <TextView
                    android:id="@+id/inputTextRole"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:textColor="@color/blue900"
                    android:text="ACTIVE"
                    />

            </androidx.cardview.widget.CardView>

        </TableRow>
        <TableRow>
            <TextView
                android:text="STATUS"
                android:padding="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginStart="10dp"
                android:textColor="@color/blue900"
                android:textAlignment="textStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                /> <!-- kasih lebar minimum -->

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutStatus"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/success"
                android:layout_marginVertical="5dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                android:padding="10dp">

                <TextView
                    android:id="@+id/inputStatus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:text="ACTIVE"
                    />

            </androidx.cardview.widget.CardView>

        </TableRow>

        <TableRow>
            <TextView
                android:text="JENIS KELAMIN"
                android:padding="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginStart="10dp"
                android:textColor="@color/blue900"
                android:textAlignment="textStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                /> <!-- kasih lebar minimum -->

            <TextView
                 android:id="@+id/inputGender"
                android:text="LAKI - LAKI"
                android:padding="10dp"
                 android:textSize="14sp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/blue900"
                 android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
        </TableRow>

        <TableRow>
            <TextView
                android:text="CABANG"
                android:padding="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginStart="10dp"
                android:textColor="@color/blue900"
                android:textAlignment="textStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                /> <!-- kasih lebar minimum -->

            <TextView
                 android:id="@+id/inputBranch"
                android:text="Surbaya"
                android:padding="10dp"
                 android:textSize="14sp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/blue900"
                 android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
        </TableRow>

        <TableRow>
            <TextView
                android:text="KONTAK"
                android:padding="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginStart="10dp"
                android:textColor="@color/blue900"
                android:textAlignment="textStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                /> <!-- kasih lebar minimum -->

            <TextView
                 android:id="@+id/inputTelephon"
                android:text="08978678898798"
                android:padding="10dp"
                 android:textSize="14sp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/blue900"
                 android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                />
        </TableRow>

        <TableRow>
            <TextView
                android:text="ALAMAT"
                android:padding="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginStart="10dp"
                android:textColor="@color/blue900"
                android:textAlignment="textStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                /> <!-- kasih lebar minimum -->

            <TextView
                 android:id="@+id/inputAddress"
                android:text="Adress"
                android:padding="10dp"
                 android:textSize="14sp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/blue900"
                 android:textAlignment="textEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="false"
                android:ellipsize="end"
                android:maxLines="3"
                android:scrollHorizontally="false"
                android:translationZ="5dp"
                />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>