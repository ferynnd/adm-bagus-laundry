<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:padding="20dp">

    <!-- Icon Warning -->
    <ImageView
        android:id="@+id/iconDanger"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_danger"
        app:tint="@color/red"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/titleConfirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Konfirmasi Penghapusan Permanen"
        android:textSize="18sp"
        android:textColor="@color/red"
        android:fontFamily="@font/inter_bold"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/iconDanger"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"/>

    <TextView
        android:id="@+id/messageConfirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Data yang dihapus secara permanen TIDAK DAPAT dikembalikan lagi!\n\nApakah Anda yakin ingin melanjutkan?"
        android:textSize="14sp"
        android:textColor="@color/gray900"
        android:fontFamily="@font/inter"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/titleConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/messageConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp">

        <Button
            android:id="@+id/buttonConfirmNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tidak"
            android:textColor="@color/blue900"
            android:backgroundTint="@color/blueBase"
            android:fontFamily="@font/inter_semibold"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/buttonConfirmYes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ya, Hapus Permanen"
            android:textColor="@color/white"
            android:backgroundTint="@color/red"
            android:fontFamily="@font/inter_semibold"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>