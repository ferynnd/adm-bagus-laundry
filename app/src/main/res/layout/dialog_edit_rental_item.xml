<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Header dengan Item Name dan Delete Button -->
        <TextView
            android:id="@+id/labelItemRental"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Item Rental"
            android:textSize="12sp"
            android:textColor="@color/blue900"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteItem"/>

        <ImageView
            android:id="@+id/btnDeleteItem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/red" />

        <!-- Spinner Item Rental -->
        <Spinner
            android:id="@+id/spinnerRentalItem"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/spinner_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/labelItemRental"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Row 1: Status dan Kondisi -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Status"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            app:boxStrokeColor="@color/blue900"
            app:hintTextColor="@color/blue900"
            app:boxStrokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerRentalItem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutCondition"
            app:layout_constraintWidth_percent="0.48"
            android:layout_marginTop="8dp">

            <AutoCompleteTextView
                android:id="@+id/inputStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="14sp"
                android:textColor="@color/blue900"
                android:fontFamily="@font/inter"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCondition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Kondisi"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            app:boxStrokeColor="@color/blue900"
            app:hintTextColor="@color/blue900"
            app:boxStrokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerRentalItem"
            app:layout_constraintStart_toEndOf="@id/layoutStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.48"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp">

            <AutoCompleteTextView
                android:id="@+id/inputCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="14sp"
                android:textColor="@color/blue900"
                android:fontFamily="@font/inter"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Row 2: Jumlah dan Berat -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Jumlah (Pcs)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxStrokeColor="@color/blue900"
            app:hintTextColor="@color/blue900"
            app:boxStrokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/layoutStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutWeight"
            app:layout_constraintWidth_percent="0.48"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="14sp"
                android:textColor="@color/blue900"
                android:fontFamily="@font/inter"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutWeight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Berat (Kg)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxStrokeColor="@color/blue900"
            app:hintTextColor="@color/blue900"
            app:boxStrokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/layoutCondition"
            app:layout_constraintStart_toEndOf="@id/layoutCount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.48"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="14sp"
                android:textColor="@color/blue900"
                android:fontFamily="@font/inter"/>

        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>