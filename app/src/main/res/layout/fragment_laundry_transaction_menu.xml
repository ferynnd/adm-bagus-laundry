<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_list_client"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />


    <ImageView
        android:id="@+id/arrowBack"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/back"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop" />

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/arrowBack"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/arrowBack"
        app:layout_constraintTop_toTopOf="@id/arrowBack">

        <TextView
            android:id="@+id/textHeaderLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/inter_light"
            android:padding="0dp"
            android:text="TRANSAKSI"
            android:textColor="@color/blue900"
            android:textSize="20sp"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/textHeaderBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:fontFamily="@font/inter_bold"
            android:padding="0dp"
            android:textColor="@color/blue900"
            android:textSize="20sp"
            tools:text="#L1234" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutTextClient"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginTop="15dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:strokeColor="#535353"
        app:strokeWidth="0.7dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutTextCash"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginTop="5dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/layoutTextClient"
        app:strokeColor="#535353"
        app:strokeWidth="0.7dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutTextStatus"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginTop="5dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/layoutTextCash"
        app:strokeColor="#535353"
        app:strokeWidth="0.7dp">

        <TableLayout
            android:id="@+id/tableLayoutStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"> <!-- Mendistribusikan lebar kolom secara merata -->

            <!-- Baris Header Tabel -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/blue100"> <!-- Latar belakang terang untuk header -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:padding="5dp"
                    android:text="STATUS TRANSAKSI"
                    android:textAlignment="center"
                    android:textColor="@color/blue900"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:padding="5dp"
                    android:text="POTONGAN &amp; TAMBAHAN"
                    android:textAlignment="center"
                    android:textColor="@color/blue900"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </TableRow>

            <!-- Baris Konten Tabel -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:padding="5dp">

                <Spinner
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginVertical="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:fontFamily="@font/inter_semibold"
                    android:textAlignment="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonOptional"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:paddingVertical="10dp"
                    android:text="Pilih Opsi"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:backgroundTint="@color/blue500"
                    app:cornerRadius="8dp"
                    app:rippleColor="@color/blue200" />
            </TableRow>
        </TableLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/logoClient"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        app:cardBackgroundColor="@color/blueBase"
        app:cardCornerRadius="40dp"
        app:layout_constraintBottom_toBottomOf="@id/layoutTextClient"
        app:layout_constraintStart_toStartOf="@id/layoutTextClient"
        app:layout_constraintTop_toTopOf="@id/layoutTextClient" />

    <androidx.cardview.widget.CardView
        android:id="@+id/logoCash"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        app:cardBackgroundColor="@color/blueBase"
        app:cardCornerRadius="40dp"
        app:layout_constraintBottom_toBottomOf="@id/layoutTextCash"
        app:layout_constraintStart_toStartOf="@id/layoutTextCash"
        app:layout_constraintTop_toTopOf="@id/layoutTextCash" />

    <ImageView
        android:id="@+id/iconClien"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="15dp"
        android:src="@drawable/clienttrans"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="@id/logoClient"
        app:layout_constraintEnd_toEndOf="@id/logoClient"
        app:layout_constraintStart_toStartOf="@id/logoClient"
        app:layout_constraintTop_toTopOf="@id/logoClient" />

    <ImageView
        android:id="@+id/iconCash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="15dp"
        android:src="@drawable/dolarcash"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="@id/logoCash"
        app:layout_constraintEnd_toEndOf="@id/logoCash"
        app:layout_constraintStart_toStartOf="@id/logoCash"
        app:layout_constraintTop_toTopOf="@id/logoCash" />


    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="@id/layoutTextClient"
        app:layout_constraintEnd_toEndOf="@id/layoutTextClient"
        app:layout_constraintStart_toEndOf="@id/logoClient"
        app:layout_constraintTop_toTopOf="@id/layoutTextClient">

        <TableRow>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:padding="3dp"
                android:paddingStart="5dp"
                android:text="NAMA PELANGGAN"
                android:textAlignment="textStart"
                android:textColor="@color/blue900"
                android:textSize="10sp" />

        </TableRow>

        <TableRow>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textClient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_semibold"
                android:hint="Masukan Nama Pelanggan"
                android:padding="5dp"
                android:textAlignment="textStart"
                android:textColor="@color/blue500"
                android:textSize="14sp" />

        </TableRow>
    </TableLayout>

    <TableLayout
        android:id="@+id/tableLayoutDolar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="@id/layoutTextCash"
        app:layout_constraintEnd_toEndOf="@id/layoutTextCash"
        app:layout_constraintStart_toEndOf="@id/logoCash"
        app:layout_constraintTop_toTopOf="@id/layoutTextCash">

        <TableRow>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:padding="3dp"
                android:paddingStart="5dp"
                android:text="UANG PELANGGAN"
                android:textAlignment="textStart"
                android:textColor="@color/blue900"
                android:textSize="10sp" />

        </TableRow>

        <TableRow>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!--                <TextView-->
                <!--                    android:id="@+id/textPrice"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="match_parent"-->
                <!--                    android:layout_marginStart="3dp"-->
                <!--                    android:fontFamily="@font/inter_semibold"-->
                <!--                    android:padding="3dp"-->
                <!--                    android:textColor="@color/blue500"-->
                <!--                    android:textSize="14sp"-->
                <!--                    android:text="Rp" />-->

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textCash"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/inter_semibold"
                    android:hint="Masukan Nominal Uang"
                    android:inputType="numberDecimal"
                    android:padding="5dp"
                    android:textAlignment="textStart"
                    android:textColor="@color/blue500"
                    android:textSize="14sp" />

            </LinearLayout>
        </TableRow>
    </TableLayout>


    <ImageView
        android:id="@+id/layoutListItem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_top"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTextStatus"
        app:strokeWidth="0dp" />


    <TextView
        android:id="@+id/textHeaderList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_bold"
        android:text="Detail Pesanan"
        android:textColor="@color/blue900"
        android:textSize="14sp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toTopOf="@id/layoutListItem" />


    <!--    <androidx.recyclerview.widget.RecyclerView-->
    <!--        android:id="@+id/recyclerView"-->
    <!--        android:layout_width="0dp"-->
    <!--        android:layout_height="0dp"-->
    <!--        android:layout_marginTop="10dp"-->
    <!--        android:translationZ="10dp"-->
    <!--        app:layout_constraintBottom_toTopOf="@id/textHeaderPembayaran"-->
    <!--        app:layout_constraintEnd_toStartOf="@id/guidelineRight"-->
    <!--        app:layout_constraintStart_toEndOf="@id/guidelineLeft"-->
    <!--        app:layout_constraintTop_toBottomOf="@id/textHeaderList"-->
    <!--        tools:listitem="@layout/card_item_detail_transaction_laundry" />-->

    <LinearLayout
        android:id="@+id/linearLayoutContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/textHeaderList" />

    <TextView
        android:id="@+id/textHeaderPembayaran"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:fontFamily="@font/inter_bold"
        android:text="Detail Pembayaran"
        android:textColor="@color/blue900"
        android:textSize="14sp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutContainer" />

    <TableLayout
        android:id="@+id/tableLayoutPembayaran"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@+id/textHeaderPembayaran">

        <TableRow>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:padding="5dp"
                android:paddingStart="5dp"
                android:text="TOTAL"
                android:textAlignment="textStart"
                android:textColor="@color/blue900"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:padding="5dp"
                android:paddingStart="5dp"
                android:textAlignment="textEnd"
                android:textColor="@color/blue900"
                android:textSize="14sp"
                tools:text="Rp. 20.000" />

        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:padding="5dp"
                android:paddingStart="5dp"
                android:text="KEMBALIAN"
                android:textAlignment="textStart"
                android:textColor="@color/blue900"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textChangeMoney"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:padding="5dp"
                android:paddingStart="5dp"
                android:textAlignment="textEnd"
                android:textColor="@color/blue900"
                android:textSize="14sp"
                tools:text="Rp. 20.000" />

        </TableRow>
    </TableLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="20dp"
        android:text="SELESAI"
        android:textSize="16sp"
        android:translationZ="20dp"
        app:backgroundTint="@color/blue500"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft" />


</androidx.constraintlayout.widget.ConstraintLayout>