<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/fragment_list_client"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"
        android:id="@+id/guidelineLeft"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        android:id="@+id/guidelineRight"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="horizontal"
        android:id="@+id/guidelineTop"/>


     <ImageView
        android:id="@+id/arrowBack"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/back"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop"/>

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        app:layout_constraintStart_toEndOf="@id/arrowBack"
        app:layout_constraintTop_toTopOf="@id/arrowBack"
        app:layout_constraintBottom_toBottomOf="@id/arrowBack"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight">

        <TextView
        android:id="@+id/textHeaderLight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_light"
        android:padding="0dp"
        android:text="TRANSAKSI"
            android:layout_marginEnd="5dp"
        android:textColor="@color/blue900"
        android:textSize="20sp"
        tools:ignore="RtlSymmetry" />

        <TextView
        android:id="@+id/textHeaderBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:fontFamily="@font/inter_bold"
        android:padding="0dp"
        tools:text="#L1234"
        android:textColor="@color/blue900"
        android:textSize="20sp"
        />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:id="@+id/layoutTextClient"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:cardCornerRadius="8dp"
        app:strokeWidth="0.7dp"
        app:strokeColor="#535353"
        android:layout_marginTop="15dp"
        />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:id="@+id/layoutTextCash"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintTop_toBottomOf="@id/layoutTextClient"
        app:cardCornerRadius="8dp"
        app:strokeWidth="0.7dp"
        app:strokeColor="#535353"
        android:layout_marginTop="5dp"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:id="@+id/logoClient"
        app:cardBackgroundColor="@color/blueBase"
        app:cardCornerRadius="40dp"
        app:layout_constraintTop_toTopOf="@id/layoutTextClient"
        app:layout_constraintStart_toStartOf="@id/layoutTextClient"
        app:layout_constraintBottom_toBottomOf="@id/layoutTextClient"
        android:layout_marginStart="20dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:id="@+id/logoCash"
        app:cardBackgroundColor="@color/blueBase"
        app:cardCornerRadius="40dp"
        app:layout_constraintTop_toTopOf="@id/layoutTextCash"
        app:layout_constraintStart_toStartOf="@id/layoutTextCash"
        app:layout_constraintBottom_toBottomOf="@id/layoutTextCash"
        android:layout_marginStart="20dp"/>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/iconClien"
        android:src="@drawable/clienttrans"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="@id/logoClient"
        app:layout_constraintBottom_toBottomOf="@id/logoClient"
        app:layout_constraintStart_toStartOf="@id/logoClient"
        app:layout_constraintEnd_toEndOf="@id/logoClient"
        android:translationZ="10dp"/>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/iconCash"
        android:src="@drawable/dolarcash"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="@id/logoCash"
        app:layout_constraintBottom_toBottomOf="@id/logoCash"
        app:layout_constraintStart_toStartOf="@id/logoCash"
        app:layout_constraintEnd_toEndOf="@id/logoCash"
        android:translationZ="10dp"/>


    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/logoClient"
        app:layout_constraintEnd_toEndOf="@id/layoutTextClient"
        app:layout_constraintTop_toTopOf="@id/layoutTextClient"
        app:layout_constraintBottom_toBottomOf="@id/layoutTextClient">

        <TableRow>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:padding="3dp"
                android:paddingStart="5dp"
                android:textAlignment="textStart"
                android:textColor="@color/blue900"
                android:textSize="10sp"
                android:text="NAMA PELANGGAN" />

        </TableRow>

        <TableRow>
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textClient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:padding="5dp"
                android:background="@android:color/transparent"
                android:textAlignment="textStart"
                android:textColor="@color/blue500"
                android:textSize="14sp"
                android:hint="Masukan Nama Pelanggan"/>

        </TableRow>
    </TableLayout>

    <TableLayout
        android:id="@+id/tableLayoutDolar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/logoCash"
        app:layout_constraintEnd_toEndOf="@id/layoutTextCash"
        app:layout_constraintTop_toTopOf="@id/layoutTextCash"
        app:layout_constraintBottom_toBottomOf="@id/layoutTextCash">

        <TableRow>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:padding="3dp"
                android:paddingStart="5dp"
                android:textAlignment="textStart"
                android:textColor="@color/blue900"
                android:textSize="10sp"
                android:text="UANG PELANGGAN" />

        </TableRow>

        <TableRow>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                >
            <TextView
                android:id="@+id/textPrice"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_semibold"
                android:padding="3dp"
                android:layout_marginStart="3dp"
                android:textColor="@color/blue500"
                android:textSize="14sp"
                tools:text="Rp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textCash"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:padding="5dp"
                android:inputType="number"
                android:background="@android:color/transparent"
                android:textAlignment="textStart"
                android:textColor="@color/blue500"
                android:textSize="14sp"
                android:hint="Masukan Nominal Uang"/>

            </LinearLayout>
        </TableRow>
    </TableLayout>


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/layoutListItem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTextCash"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/rounded_top"
        android:layout_marginTop="10dp"
        app:strokeWidth="0dp"
        app:cardElevation="8dp"
        />


    <TextView
        android:id="@+id/textHeaderList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/blue900"
        android:textSize="14sp"
        android:translationZ="10dp"
                app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toTopOf="@id/layoutListItem"
        android:text="Detail Pesanan" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        tools:listitem="@layout/card_item_detail_transaction_laundry"
        android:layout_marginTop="10dp"
        android:translationZ="10dp"
        app:layout_constraintTop_toBottomOf="@id/textHeaderList"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintBottom_toTopOf="@id/textHeaderPembayaran"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"/>


     <TextView
        android:id="@+id/textHeaderPembayaran"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/blue900"
        android:textSize="14sp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
         app:layout_constraintBottom_toTopOf="@id/tableLayoutPembayaran"
        android:text="Detail Pembayaran" />

    <TableLayout
        android:id="@+id/tableLayoutPembayaran"
        android:layout_width="0dp"
        android:translationZ="10dp"
        android:layout_marginVertical="10dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintBottom_toTopOf="@id/btnSubmit">

        <TableRow>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:padding="5dp"
                android:paddingStart="5dp"
                android:textAlignment="textStart"
                android:textColor="@color/blue900"
                android:textSize="12sp"
                android:text="TOTAL" />

            <TextView
                android:id="@+id/textTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:padding="5dp"
                android:paddingStart="5dp"
                android:textAlignment="textEnd"
                android:textColor="@color/blue900"
                android:textSize="14sp"
                tools:text="Rp. 20.000" />

        </TableRow>
        <TableRow>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:padding="5dp"
                android:paddingStart="5dp"
                android:textAlignment="textStart"
                android:textColor="@color/blue900"
                android:textSize="12sp"
                android:text="KEMBALIAN" />

            <TextView
                android:id="@+id/textChangeMoney"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:padding="5dp"
                android:paddingStart="5dp"
                android:textAlignment="textEnd"
                android:textColor="@color/blue900"
                android:textSize="14sp"
                tools:text="Rp. 20.000" />

        </TableRow>
    </TableLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="SELESAI"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        android:translationZ="20dp"
        app:backgroundTint="@color/blue500"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft" />




</androidx.constraintlayout.widget.ConstraintLayout>