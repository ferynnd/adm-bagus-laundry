<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.admin.AdminDashboardFragment">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="vertical"
        android:id="@+id/guidelineLeft"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.95"
        android:orientation="vertical"
        android:id="@+id/guidelineRight"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.05"
        android:orientation="horizontal"
        android:id="@+id/guidelineTop"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.5"
        android:orientation="vertical"
        android:id="@+id/guidelineMid"/>


    <TextView
        android:id="@+id/headerSelamat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selamat"
        android:fontFamily="@font/inter_light"
        android:textColor="@color/blue900"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toTopOf="@id/guidelineTop"
        />

    <TextView
        android:id="@+id/headerDatang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Datang,"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/blue900"
        android:textSize="22sp"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toEndOf="@id/headerSelamat"
        app:layout_constraintTop_toTopOf="@id/headerSelamat"
        app:layout_constraintBottom_toBottomOf="@id/headerSelamat"
        />

    <TextView
        android:id="@+id/headerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NANDO"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/blue900"
        android:textSize="36sp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/headerSelamat"
        />

    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="40dp"
        android:layout_height="50dp"
        android:src="@drawable/menuicon"
        android:translationZ="10dp"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop"
        app:layout_constraintBottom_toBottomOf="@id/headerSelamat"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/menuProduct"
        android:layout_width="0dp"
        android:layout_height="180dp"
        app:cardCornerRadius="15dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/headerName"
        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
        />

    <ImageView
        android:id="@+id/iconProduct"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:src="@drawable/product"
        android:translationY="-15dp"
        app:layout_constraintStart_toStartOf="@id/menuProduct"
        app:layout_constraintTop_toTopOf="@id/menuProduct"
        app:layout_constraintEnd_toEndOf="@id/menuProduct"
        app:layout_constraintBottom_toBottomOf="@id/menuProduct"
        />



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRODUK"
        android:textColor="@color/blue900"
        app:layout_constraintStart_toStartOf="@id/menuProduct"
        app:layout_constraintEnd_toEndOf="@id/menuProduct"
        app:layout_constraintTop_toBottomOf="@id/iconProduct"
        android:textSize="15sp"
        android:fontFamily="@font/inter_bold"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/menuReport"
        android:layout_width="0dp"
        android:layout_height="180dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/guidelineMid"
        app:layout_constraintTop_toTopOf="@id/menuProduct"
        app:layout_constraintBottom_toBottomOf="@id/menuProduct"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        />

    <ImageView
        android:id="@+id/iconReport"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:src="@drawable/report"
        android:translationY="-15dp"
        app:layout_constraintStart_toStartOf="@id/menuReport"
        app:layout_constraintTop_toTopOf="@id/menuReport"
        app:layout_constraintEnd_toEndOf="@id/menuReport"
        app:layout_constraintBottom_toBottomOf="@id/menuReport"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LAPORAN"
        android:textColor="@color/blue900"
        app:layout_constraintStart_toStartOf="@id/iconReport"
        app:layout_constraintEnd_toEndOf="@id/iconReport"
        app:layout_constraintTop_toBottomOf="@id/iconReport"
        android:textSize="15sp"
        android:fontFamily="@font/inter_bold"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/menuClient"
        android:layout_width="0dp"
        android:layout_height="180dp"
        app:cardCornerRadius="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="@id/guidelineMid"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintTop_toBottomOf="@id/menuProduct"
        />

    <ImageView
        android:id="@+id/iconClient"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:src="@drawable/handshake"
        android:translationY="-8dp"
        app:layout_constraintStart_toStartOf="@id/menuClient"
        app:layout_constraintTop_toTopOf="@id/menuClient"
        app:layout_constraintEnd_toEndOf="@id/menuClient"
        app:layout_constraintBottom_toBottomOf="@id/menuClient"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KLIEN"
        android:textColor="@color/blue900"
        app:layout_constraintStart_toStartOf="@id/iconClient"
        app:layout_constraintEnd_toEndOf="@id/iconClient"
        app:layout_constraintTop_toBottomOf="@id/iconClient"
        android:textSize="15sp"
        android:fontFamily="@font/inter_bold"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/menuBranch"
        android:layout_width="0dp"
        android:layout_height="180dp"
        app:cardCornerRadius="15dp"
        android:layout_marginTop="10dp"
        app:cardElevation="0dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
        app:layout_constraintTop_toBottomOf="@id/menuProduct"
        />

    <ImageView
        android:id="@+id/iconBranch"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:src="@drawable/home"
        android:translationY="-8dp"
        app:layout_constraintStart_toStartOf="@id/menuBranch"
        app:layout_constraintTop_toTopOf="@id/menuBranch"
        app:layout_constraintEnd_toEndOf="@id/menuBranch"
        app:layout_constraintBottom_toBottomOf="@id/menuBranch"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CABANG"
        android:textColor="@color/blue900"
        app:layout_constraintStart_toStartOf="@id/iconBranch"
        app:layout_constraintEnd_toEndOf="@id/iconBranch"
        app:layout_constraintTop_toBottomOf="@id/iconBranch"
        android:textSize="15sp"
        android:fontFamily="@font/inter_bold"
        />



    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DATA MASUK"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_semibold"
        android:textSize="15sp"
        android:textColor="@color/blue900"
        app:layout_constraintTop_toBottomOf="@id/menuBranch"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        />

</androidx.constraintlayout.widget.ConstraintLayout>