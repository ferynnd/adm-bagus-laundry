<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_list_user"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />


    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/btnRoutes"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop">

        <TextView
            android:id="@+id/textHeaderLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:padding="0dp"
            android:text="ITEM"
            android:textColor="@color/blue900"
            android:textSize="22sp"
            tools:ignore="RtlSymmetry" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btnRoutes"
        android:layout_width="45dp"
        android:layout_height="32dp"
        android:layout_margin="0dp"
        android:padding="0dp"
        android:src="@drawable/routes"
        android:translationX="7dp"
        app:layout_constraintBottom_toBottomOf="@id/layoutHeader"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintTop_toTopOf="@id/layoutHeader" />

    <androidx.cardview.widget.CardView
        android:id="@+id/layoutLaundry"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        app:cardBackgroundColor="@color/blue600"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <androidx.cardview.widget.CardView
        android:id="@+id/layoutRental"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="5dp"
        app:cardBackgroundColor="@color/blueDark"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/layoutLaundry"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineCenter"
        app:layout_constraintTop_toTopOf="@id/layoutLaundry" />


    <ImageView
        android:id="@+id/iconProduct"
        android:layout_width="50dp"
        android:layout_height="0dp"
        android:padding="10dp"
        android:src="@drawable/product"
        app:layout_constraintBottom_toBottomOf="@id/layoutLaundry"
        app:layout_constraintStart_toStartOf="@id/layoutLaundry"
        app:layout_constraintTop_toTopOf="@id/layoutLaundry"
        app:layout_constraintEnd_toStartOf="@id/textLaundry"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/textLaundry"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:text="LAUNDRY"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/layoutLaundry"
        app:layout_constraintEnd_toEndOf="@id/layoutLaundry"
        app:layout_constraintStart_toEndOf="@id/iconProduct"
        app:layout_constraintTop_toTopOf="@id/layoutLaundry" />

    <ImageView
        android:id="@+id/iconRental"
        android:layout_width="50dp"
        android:layout_height="0dp"
        android:padding="10dp"
        android:src="@drawable/product"
        app:layout_constraintEnd_toStartOf="@id/textRental"
        app:layout_constraintBottom_toBottomOf="@id/layoutRental"
        app:layout_constraintStart_toStartOf="@id/layoutRental"
        app:layout_constraintTop_toTopOf="@id/layoutRental"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/textRental"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:text="SEWA"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/layoutRental"
        app:layout_constraintEnd_toEndOf="@id/layoutRental"
        app:layout_constraintStart_toEndOf="@id/iconRental"
        app:layout_constraintTop_toTopOf="@id/layoutRental" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/layoutLaundry"
        tools:listitem="@layout/card_client" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progresBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineRight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guidelineTop" />

</androidx.constraintlayout.widget.ConstraintLayout>