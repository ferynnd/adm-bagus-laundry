<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.admin.AdminDashboardFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineMid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />


    <TextView
        android:id="@+id/headerSelamat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_light"
        android:text="Selamat"
        android:textColor="@color/blue900"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toTopOf="@id/guidelineTop" />

    <TextView
        android:id="@+id/headerDatang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:fontFamily="@font/inter_medium"
        android:text="Datang,"
        android:textColor="@color/blue900"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@id/headerSelamat"
        app:layout_constraintStart_toEndOf="@id/headerSelamat"
        app:layout_constraintTop_toTopOf="@id/headerSelamat" />

    <TextView
        android:id="@+id/headerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="NANDO"
        android:textColor="@color/blue900"
        android:textSize="36sp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/headerSelamat" />

    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="40dp"
        android:layout_height="50dp"
        android:src="@drawable/menuicon"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="@id/headerSelamat"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop" />

    <androidx.cardview.widget.CardView
        android:id="@+id/menuLaundry"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="5dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/headerName" />

    <ImageView
        android:id="@+id/iconLaundry"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:src="@drawable/laundry"
        android:translationY="-15dp"
        app:layout_constraintBottom_toBottomOf="@id/menuLaundry"
        app:layout_constraintEnd_toEndOf="@id/menuLaundry"
        app:layout_constraintStart_toStartOf="@id/menuLaundry"
        app:layout_constraintTop_toTopOf="@id/menuLaundry" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="LAUNDRY"
        android:textColor="@color/blue900"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="@id/menuLaundry"
        app:layout_constraintStart_toStartOf="@id/menuLaundry"
        app:layout_constraintTop_toBottomOf="@id/iconLaundry" />

    <androidx.cardview.widget.CardView
        android:id="@+id/menuRental"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginStart="5dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/menuLaundry"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineMid"
        app:layout_constraintTop_toTopOf="@id/menuLaundry" />

    <ImageView
        android:id="@+id/iconRental"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:src="@drawable/persewaan"
        android:translationY="-15dp"
        app:layout_constraintBottom_toBottomOf="@id/menuRental"
        app:layout_constraintEnd_toEndOf="@id/menuRental"
        app:layout_constraintStart_toStartOf="@id/menuRental"
        app:layout_constraintTop_toTopOf="@id/menuRental" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="PERSEWAAN"
        android:textColor="@color/blue900"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="@id/iconRental"
        app:layout_constraintStart_toStartOf="@id/iconRental"
        app:layout_constraintTop_toBottomOf="@id/iconRental" />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_semibold"
        android:text="TRANSAKSI TERBARU"
        android:textColor="@color/blue900"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/menuLaundry" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        tools:listitem="@layout/card_dashboard" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progresBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="@id/recyclerView"
        app:layout_constraintEnd_toEndOf="@id/recyclerView"
        app:layout_constraintStart_toStartOf="@id/recyclerView"
        app:layout_constraintTop_toTopOf="@id/recyclerView" />

</androidx.constraintlayout.widget.ConstraintLayout>