<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineMid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />


    <TextView
        android:id="@+id/headerSelamat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_light"
        android:text="Selamat"
        android:textColor="@color/blue900"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toTopOf="@id/guidelineTop" />

    <TextView
        android:id="@+id/headerDatang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:fontFamily="@font/inter_medium"
        android:text="Datang,"
        android:textColor="@color/blue900"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@id/headerSelamat"
        app:layout_constraintStart_toEndOf="@id/headerSelamat"
        app:layout_constraintTop_toTopOf="@id/headerSelamat" />

    <TextView
        android:id="@+id/headerName"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/inter_bold"
        android:maxLines="1"
        android:singleLine="true"
        android:text="ahmad hamdani adadadas"
        android:textColor="@color/blue900"
        android:textSize="36sp"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/headerSelamat" />



    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="40dp"
        android:layout_height="50dp"
        android:src="@drawable/menuicon"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="@id/headerSelamat"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop" />

    <androidx.cardview.widget.CardView
        android:id="@+id/menuTransaksiRental"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginStart="7dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/menuTransaksiLaundry"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineMid"
        app:layout_constraintTop_toTopOf="@id/menuTransaksiLaundry" />

    <ImageView
        android:id="@+id/iconTransaksiRental"
        android:layout_width="90dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:src="@drawable/sewa"
        android:translationY="-15dp"
        app:layout_constraintBottom_toBottomOf="@id/menuTransaksiRental"
        app:layout_constraintEnd_toEndOf="@id/menuTransaksiRental"
        app:layout_constraintStart_toStartOf="@id/menuTransaksiRental"
        app:layout_constraintTop_toTopOf="@id/menuTransaksiRental" />

    <TextView
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="PESEWAAN"
        android:textAlignment="center"
        android:textColor="@color/blue900"
        android:textSize="13sp"
        android:translationY="-10dp"
        app:layout_constraintEnd_toEndOf="@id/iconTransaksiRental"
        app:layout_constraintStart_toStartOf="@id/iconTransaksiRental"
        app:layout_constraintTop_toBottomOf="@id/iconTransaksiRental" />

    <androidx.cardview.widget.CardView
        android:id="@+id/menuTransaksiLaundry"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="7dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/headerName" />

    <ImageView
        android:id="@+id/iconLaundry"
        android:layout_width="90dp"
        android:layout_height="80dp"
        android:src="@drawable/laundry"
        android:translationY="-15dp"
        app:layout_constraintBottom_toBottomOf="@id/menuTransaksiLaundry"
        app:layout_constraintEnd_toEndOf="@id/menuTransaksiLaundry"
        app:layout_constraintStart_toStartOf="@id/menuTransaksiLaundry"
        app:layout_constraintTop_toTopOf="@id/menuTransaksiLaundry" />

    <TextView
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="LAUNDRY"
        android:textAlignment="center"
        android:textColor="@color/blue900"
        android:textSize="13sp"
        android:translationY="-10dp"
        app:layout_constraintEnd_toEndOf="@id/iconLaundry"
        app:layout_constraintStart_toStartOf="@id/iconLaundry"
        app:layout_constraintTop_toBottomOf="@id/iconLaundry" />

