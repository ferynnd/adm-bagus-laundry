<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_data"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineMid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <Spinner
            android:id="@+id/spinnerRental"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/trash_create_list_transaksi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/trash_create_list_transaksi"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:backgroundTint="@color/transaksiOut"
            android:background="@drawable/trash"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outlinedSelectedStatus"
            style="@style/CustomTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:hint="Status"
            app:layout_constraintEnd_toStartOf="@+id/guidelineMid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spinnerRental"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/input_status_list_transaksi_rental"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outlinedSelectedKondisi"
            style="@style/CustomTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:hint="Kondisi"
            app:endIconMode="dropdown_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineMid"
            app:layout_constraintTop_toBottomOf="@+id/spinnerRental">

            <AutoCompleteTextView
                android:id="@+id/input_kondisi_list_transaksi_rental"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/inter"
                android:inputType="none"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outlinedTextBerat"
            style="@style/CustomTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:hint="Berat"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineMid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/outlinedSelectedKondisi">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_berat_list_transaksi_rental"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/inter"
                android:inputType="numberDecimal"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outlinedTextPcs"
            style="@style/CustomTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Pcs"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guidelineMid"
            app:layout_constraintTop_toBottomOf="@+id/outlinedSelectedKondisi">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_pcs_list_transaksi_rental"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/inter"
                android:inputType="numberDecimal"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>