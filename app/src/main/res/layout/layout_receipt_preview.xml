<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:fontFamily="@font/inter"
    tools:background="@color/white">

    <!-- Header Section -->
    <TextView
        android:id="@+id/text_store_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BAGUS LAUNDRY"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textColor="@color/gray900"
        android:fontFamily="@font/inter_bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/text_store_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="-"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/gray900"
        android:layout_marginBottom="16dp" />

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray900"
        android:layout_marginBottom="12dp" />

    <!-- Invoice Information Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="INVOICE"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_invoice_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PELANGGAN"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_client_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WAKTU "
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_order_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STATUS"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold"/>
    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/dashed_line"
        android:layout_marginBottom="12dp" />

    <!-- Items Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="ITEM (Berat)"
            android:padding="3dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="end"
            android:padding="3dp"
            android:text="HARGA"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold"/>
    </LinearLayout>

    <!-- Items List Container -->
    <LinearLayout
        android:id="@+id/layout_item_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <!-- Sample Item - Remove this in production -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:text="Regular Wash (5.0 kg)"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/gray900" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="end"
                android:text="Rp 30.000"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/gray900" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:text="Express Wash (10.8 kg)"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/gray900" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="end"
                android:text="Rp 64.800"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/gray900" />
        </LinearLayout>

    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/dashed_line"
        android:layout_marginBottom="12dp" />

    <!-- Summary Section -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SUBTOTAL"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_subtotal_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PROMO"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_promo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TAMBAHAN"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_additional_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/dashed_line"
        android:layout_marginBottom="12dp" />

    <!-- Total Payment Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:padding="5dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TOTAL PEMBAYARAN"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_bold"/>

        <TextView
            android:id="@+id/text_total_payment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="-"
            android:textColor="@color/gray900" />
    </LinearLayout>

    <!-- Payment Details Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CASH"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_cash_paid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KEMBALIAN"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900" />
        <TextView
            android:id="@+id/text_change_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold" />
    </LinearLayout>

    <!-- Notes Section -->
    <LinearLayout
        android:id="@+id/layout_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_notes_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CATATAN"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:fontFamily="@font/inter_semibold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/text_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Some additional notes about the transaction."
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/gray900"
            android:padding="5dp"/>

    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray900"
        android:layout_marginBottom="16dp" />

    <!-- Footer Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Terima Kasih"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textColor="@color/gray900"
        android:fontFamily="@font/inter_bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Telah Mempercayakan\nLaundry'an Anda Kepada Kami"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="@color/gray900"
        android:fontStyle="italic" />

</LinearLayout>